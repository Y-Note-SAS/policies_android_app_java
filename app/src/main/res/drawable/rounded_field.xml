<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fond blanc -->
    <solid android:color="#FFFFFF"/>

    <!-- Bordure -->
    <stroke
        android:width="1dp"
        android:color="#BDBDBD" />

    <!-- Coins arrondis -->
    <corners android:radius="12dp" />

    <!-- Padding interne -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp"/>
</shape>
